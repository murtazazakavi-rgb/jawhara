# Copy this file to .env and populate the variables for your local device environment

# Prisma Query Engine configuration (required for environments with strict library validation like macOS)
PRISMA_CLIENT_ENGINE_TYPE="binary"
PRISMA_CLI_QUERY_ENGINE_TYPE="binary"

# PostgreSQL connection string (Neon in production)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Session encryption secret (Choose a secure random 32 character key)
SESSION_SECRET="jawhara-os-very-secure-random-key-2026-very-long"

# Google Gemini API key (optional: AI features report unavailable when empty)
GEMINI_API_KEY=""

# Payment provider. Use "razorpay" in production.
PAYMENT_PROVIDER="razorpay"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_WEBHOOK_SECRET=""

# Development-only payment diagnostics. Never enable these in production.
ALLOW_MOCK_PAYMENTS="false"
ALLOW_INSECURE_RAZORPAY_WEBHOOKS="false"

# Public site URL (used by WhatsApp share generators)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# WhatsApp Integration Configuration
WHATSAPP_PROVIDER="evolution" # evolution | meta | mock
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="jawhara-evolution-secret-key-2026"
EVOLUTION_INSTANCE_NAME="jawhara"
